{
  "name": "@a-novel-kit/uikit",
  "version": "0.29.1",
  "private": false,
  "description": "Composable Svelte components for the A-Novel design system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel-kit/uikit.git"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./authorization": {
      "types": "./dist/authorization.d.ts",
      "default": "./dist/authorization.js"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@a-novel-kit/uikit-fonts": "workspace:*",
    "@a-novel-kit/uikit-tokens": "workspace:*",
    "@lucide/svelte": "catalog:"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-i18n": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "^5.2.4",
    "i18next": "catalog:",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@a-novel-kit/nodelib-i18n": "^2.16.1",
    "i18next": "^27.2.7",
    "svelte": "^5.59.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
