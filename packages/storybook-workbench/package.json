{
  "name": "@a-novel-kit/uikit-storybook-workbench",
  "version": "0.24.1",
  "private": true,
  "description": "Private component workbench and design-system documentation for A-Novel UI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "storybook build --output-dir storybook-static",
    "storybook": "BROWSER=none storybook dev --port 6006 --no-open",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@a-novel-kit/ui-images": "0.3.0",
    "@a-novel-kit/uikit": "workspace:*",
    "@a-novel-kit/uikit-fonts": "workspace:*",
    "@a-novel-kit/uikit-icons": "workspace:*",
    "@a-novel-kit/uikit-storybook": "workspace:*",
    "@a-novel-kit/uikit-tokens": "workspace:*",
    "@lucide/svelte": "catalog:"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-i18n": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-svelte-csf": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/svelte-vite": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:"
  }
}
