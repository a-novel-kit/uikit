{
  "name": "@a-novel-kit/uikit-tokens",
  "version": "0.29.1",
  "private": false,
  "description": "Generated color, typography, spacing, shape, and motion tokens for A-Novel interfaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel-kit/uikit.git"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./canvas.css": "./canvas.css",
    "./palette": {
      "types": "./palette.d.ts",
      "default": "./palette.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "bin": {
    "uikit-token-contract": "./scripts/check-token-contract.mjs"
  },
  "files": [
    "canvas.css",
    "colors.css",
    "palette.d.ts",
    "palette.js",
    "scripts/check-token-contract.mjs",
    "tokens.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm generate:colors",
    "check:colors": "node scripts/generate-colors.mjs --check",
    "check:tokens": "node scripts/check-token-contract.mjs --docs .. ../uikit/src/lib",
    "generate:colors": "node scripts/generate-colors.mjs"
  },
  "devDependencies": {
    "colorjs.io": "catalog:"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
