{
  "name": "uikit-project",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel-kit/uikit.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    ".",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "check:packages": "node scripts/check-package-contract.mjs",
    "format": "prettier --write . --config prettier.config.ts",
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm lint:docs && pnpm lint:generated && pnpm lint:stylecheck && pnpm lint:typecheck && pnpm lint:eslint",
    "lint:ci": "pnpm build && pnpm lint",
    "lint:docs": "node scripts/check-public-docs.mjs",
    "lint:eslint": "eslint .",
    "lint:generated": "pnpm --filter @a-novel-kit/uikit-tokens check:colors",
    "lint:stylecheck": "prettier --check . --config prettier.config.ts",
    "lint:typecheck": "pnpm -r --if-present typecheck",
    "storybook": "pnpm --filter @a-novel-kit/uikit-storybook build && pnpm --filter @a-novel-kit/uikit-storybook-workbench storybook",
    "test": "pnpm --filter @a-novel-kit/uikit-storybook build && vitest run",
    "test:ci": "pnpm build && pnpm check:packages && pnpm test",
    "test:storybook": "pnpm --filter @a-novel-kit/uikit-storybook build && vitest run --project=storybook --coverage.enabled=false"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-config": "catalog:",
    "@eslint/config-helpers": "catalog:",
    "@eslint/js": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@sveltejs/vite-plugin-svelte": "^7.0.1",
    "@trivago/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "^24.10.0",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.0.0",
    "jiti": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-svelte": "^4.0.0",
    "storybook": "catalog:",
    "svelte": "^5.55.8",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
