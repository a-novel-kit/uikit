{
  "name": "uikit-project",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel-kit/uikit.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    ".",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "format": "prettier --write . --config prettier.config.ts",
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm lint:stylecheck && pnpm lint:typecheck && pnpm lint:eslint",
    "lint:ci": "pnpm build && pnpm lint",
    "lint:eslint": "eslint .",
    "lint:stylecheck": "prettier --check . --config prettier.config.ts",
    "lint:typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:ci": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-config": "catalog:",
    "@eslint/config-helpers": "catalog:",
    "@eslint/js": "catalog:",
    "@trivago/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "^17.0.0",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
